<Application x:Class="PalRelay.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#1e2430"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2a3242"/>
        <SolidColorBrush x:Key="LogBrush" Color="#161b24"/>
        <SolidColorBrush x:Key="TextBrush" Color="#e8eef7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9fb0c3"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#7a8aa0"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#7ec97f"/>
        <SolidColorBrush x:Key="BusyBrush" Color="#e07a5f"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3a4558"/>
            <Setter Property="Foreground" Value="#e8eef7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
