<Window x:Class="PalRelay.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalRelay - 帕魯輪流開服" Height="680" Width="940"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="180"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="世界:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
      <Button x:Name="ImportBtn" DockPanel.Dock="Right" Content="匯入既有世界" Margin="8,0,0,0" Click="ImportBtn_Click"/>
      <Button x:Name="NewWorldBtn" DockPanel.Dock="Right" Content="+ 新世界" Margin="8,0,0,0" Click="NewWorldBtn_Click"/>
      <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="重新整理" Margin="8,0,0,0" Click="RefreshBtn_Click"/>
      <ComboBox x:Name="WorldCombo" FontSize="14" SelectionChanged="WorldCombo_SelectionChanged"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,10,0">
        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock x:Name="StatusText" Text="載入中..." Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailText" Text="" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="世界設定" Foreground="{StaticResource MutedBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock x:Name="SettingsText" Text="(讀取中...)" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
          </StackPanel>
        </Border>

        <DockPanel>
          <Button x:Name="CopyBtn" DockPanel.Dock="Right" Content="複製" Margin="8,0,0,0" IsEnabled="False" Click="CopyBtn_Click"/>
          <TextBox x:Name="ConnectBox" IsReadOnly="True" FontSize="13" Text="(開服後這裡會顯示朋友要輸入的連線位址)"
                   Background="{StaticResource CardBrush}" Foreground="{StaticResource MutedBrush}" BorderThickness="0" Padding="8"/>
        </DockPanel>
      </StackPanel>

      <StackPanel Grid.Column="1">
        <Button x:Name="ActionBtn" Content="開始當主機" Height="64" FontSize="20" FontWeight="Bold"
                Background="#3fa860" Foreground="White" Margin="0,0,0,12" Click="ActionBtn_Click"/>
        <Button x:Name="FixhostBtn" Content="完成角色搬遷(匯入後)" Height="34" Margin="0,0,0,8" Click="FixhostBtn_Click"/>
        <Button x:Name="FixmapBtn" Content="修復地圖探索" Height="34" Margin="0,0,0,8" Click="FixmapBtn_Click"/>
        <Button x:Name="OpenFolderBtn" Content="開啟伺服器存檔資料夾" Height="34" Margin="0,0,0,8" Click="OpenFolderBtn_Click"/>
        <Button x:Name="HelpBtn" Content="使用說明(GitHub)" Height="34" Margin="0,0,0,8" Click="HelpBtn_Click"/>
        <TextBlock x:Name="ToolVerText" Text="" Foreground="#55647a" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
             Background="{StaticResource LogBrush}" Foreground="{StaticResource MutedBrush}" BorderThickness="0"
             Padding="8" Margin="0,10,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
  </Grid>
</Window>
